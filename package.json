{
  "name": "dsh-skill-creator",
  "version": "0.1.0",
  "description": "One-shot DSH skill (SKILL.md) generator: capture intent, draft, validate, package and distribute skills from inside a DeepSeek Harness session.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "scripts",
    "README.md",
    "cordis.yml",
    "LICENSE",
    "docs/store-evidence.md"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node tests/smoke.e2e.ts",
    "validate:py": "python3 scripts/quick_validate.py",
    "pack:py": "python3 scripts/package_skill.py"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^5.5.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.yml"
    },
    "compatibility": {
      "node": ">=22.18.0",
      "dsh": ">=0.1.0"
    },
    "permissions": {
      "summary": "在 DSH 会话内从提示/文档/流程描述生成 SKILL.md（draft/validate/package/improve_description 四个工具）。技能写入 $DSH_HOME/skills 或 customSkillDirs；打包 .skill 为本地 ZIP。无网络、无凭据、无外部服务。",
      "commands": [
        "node <pkg>/dist/lib/package-skill.js (zip via node archiver-equivalent, fixed argv; non-shell)",
        "python3 <pkg>/scripts/quick_validate.py (optional local dev helper, non-shell)"
      ],
      "writePaths": [
        "$DSH_HOME/skills/",
        "customSkillDirs[0]",
        "outputDir"
      ],
      "externalServices": [],
      "failureBoundaries": [
        "validation failure refuses packaging",
        "structured errors"
      ],
      "lifecycleEvidence": [
        "smoke 45 assertions offline",
        "entry lib/index.js import OK"
      ]
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "skill",
    "skill-creator",
    "cordis",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/988hj7tczd-oss/dsh-skill-creator.git"
  }
}
